# Copy to .env and fill in. Nothing here is required to run the factory locally —
# every integration degrades gracefully when its key is missing.

# ---------------------------------------------------------------- runtime ----
KRISH_ENV=prod
KRISH_LOG_LEVEL=INFO
KRISH_API_HOST=0.0.0.0
KRISH_API_PORT=8000

# memory = single process, zero dependencies (dev)
# redis   = durable streams, agents can span processes/machines (VPS)
KRISH_BUS=redis
REDIS_URL=redis://redis:6379/0

# sqlite for dev, postgres on the VPS (docker-compose sets this for you)
DATABASE_URL=postgresql+psycopg://krish:krish@postgres:5432/krish
POSTGRES_USER=krish
POSTGRES_PASSWORD=change-me
POSTGRES_DB=krish

# Set to "off" to stop automatic cycles and drive the factory only from the UI.
KRISH_SCHEDULER=on

# Resource ceiling for the container (see docker-compose.yml)
KRISH_CPU_LIMIT=3.0
KRISH_MEM_LIMIT=3g

# ------------------------------------------------------------------- LLM -----
# Optional. Without it, the researcher/architect/doc_writer use deterministic
# generation and the factory keeps producing. The LLM only writes prose and
# hypotheses — never numbers, never verdicts.
# KRISH_LLM_PROVIDER=anthropic        # anthropic | openai | none
# KRISH_LLM_MODEL=claude-sonnet-4-20250514
# KRISH_LLM_API_KEY=

# -------------------------------------------------------------- delivery -----
# Telegram: create a bot with @BotFather, then get your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
# Also flip delivery.telegram_enabled to true in config/factory.yaml
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Google Drive: service-account JSON, shared with the target folder.
# Needs the optional extra: pip install -e "backend[delivery]"
# Also flip delivery.drive_enabled to true in config/factory.yaml
# GDRIVE_CREDENTIALS_FILE=/app/config/gdrive-service-account.json
# GDRIVE_FOLDER_ID=

# --------------------------------------------------------------- safety ------
# Hard gate on anything that could place a real order. Leave false until you
# have compared demo fills against the backtest yourself.
KRISH_ALLOW_LIVE=false

# Plumbing tests only: lets the data layer fabricate bars when a provider is
# unreachable. Never leave this on — verdicts from synthetic data are worthless.
KRISH_ALLOW_SYNTHETIC=0
